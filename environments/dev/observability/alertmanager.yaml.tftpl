alertmanager_config: |
  route:
    receiver: email
    group_by: [alertname, severity]
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
  receivers:
    - name: email
      sns_configs:
        - topic_arn: ${topic_arn}
          sigv4:
            region: ${region}
          subject: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} ({{ .CommonLabels.severity }})'
          attributes:
            severity: '{{ .CommonLabels.severity }}'

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Keep the lock file in Git
!.terraform.lock.hcl
# Editors / OS
.idea/
.vscode/
.DS_Store
# Secrets - never commit
*.pem
# Exception: public Amazon RDS CA certificates (no keys), used for sslmode=verify-full.
!apps/backend/certs/rds-global-bundle.pem
*.key
.env
# Per-account backend settings (copy of environments/backend.hcl.example)
environments/backend.hcl
# Python
__pycache__/
.pytest_cache/
.venv/
# Reusable modules do not pin providers; only root stacks keep a lock file
modules/**/.terraform.lock.hcl
tfplan
backend.hcl

# Load test virtualenv and results (Phase 8)
loadtest/.venv/
loadtest/results/

# Generated guide HTML (PDFs are committed)
docs/guides/html/
